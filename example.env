# MCP transport: "stdio" for local dev; "streamable-http" for Docker/remote.
MCP_TRANSPORT=streamable-http

# MCP network settings (used with streamable-http)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# FastMCP reads these specific env vars for host/port binding.
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8000

# Aegis instance this server reads. Read-only: every tool maps to a GET.
AEGIS_API_URL=https://aegis.example.com

# Master API key. Spans EVERY site on the instance, and site reads return
# per-site secrets, so treat this env file as credential material.
AEGIS_MASTER_API_KEY=
